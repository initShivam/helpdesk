DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional server-side session lifetime in seconds (production default: 28800).
# SESSION_COOKIE_AGE=28800
DJANGO_CACHE_URL=redis://localhost:6379/1

POSTGRES_DB=helpdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# E2E test database (PostgreSQL 18)
E2E_POSTGRES_DB=helpdesk_e2e
E2E_POSTGRES_USER=postgres
E2E_POSTGRES_PASSWORD=admin
E2E_POSTGRES_HOST=localhost
E2E_POSTGRES_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Development defaults to offline local embeddings. Set to ollama when the service is reachable.
EMBEDDING_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
PGVECTOR_ENABLED=False
AI_SUGGESTION_TIMEOUT=30
AI_REQUESTS_PER_HOUR=60/hour

# Change this before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=change-me-before-shared-deployment

EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_TIMEOUT=30
EMAIL_POLL_INTERVAL_SECONDS=60

# Outbound resolution notifications (use a Gmail App Password, never an account password).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=True
EMAIL_SMTP_USE_SSL=False
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_TIMEOUT_SECONDS=15

# Meta WhatsApp Cloud API
WHATSAPP_ENABLED=True
WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
# Optional S3-compatible media storage. Required for durable/shared Render attachments.
MEDIA_STORAGE_BACKEND=filesystem
# MEDIA_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
