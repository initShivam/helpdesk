DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional server-side session lifetime in seconds (production default: 28800).
# SESSION_COOKIE_AGE=28800
DJANGO_CACHE_URL=redis://localhost:6379/1

POSTGRES_DB=helpdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# E2E test database (PostgreSQL 18)
E2E_POSTGRES_DB=helpdesk_e2e
E2E_POSTGRES_USER=postgres
E2E_POSTGRES_PASSWORD=admin
E2E_POSTGRES_HOST=localhost
E2E_POSTGRES_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
PGVECTOR_ENABLED=False
AI_SUGGESTION_TIMEOUT=30
AI_REQUESTS_PER_HOUR=60/hour

# Change this before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=change-me-before-shared-deployment

EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_TIMEOUT=30
